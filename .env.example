# Local development only. Run python3 scripts/init_local_env.py once.
# Never replace credentials while retaining an existing PostgreSQL volume.
POSTGRES_PASSWORD=GENERATE_LOCALLY
DEV_DB_PASSWORD=GENERATE_LOCALLY
TEST_DB_PASSWORD=GENERATE_LOCALLY
DJANGO_SECRET_KEY=GENERATE_LOCALLY
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
KAZAN_HTTP_PORT=8000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
WEATHER_NETWORK_ENABLED=0

KAZAN_MONITOR_PORT=19006
KAZAN_RESTORE_PORT=18016
